---
import Base from '../layouts/Base.astro';
import PlannerGrid from '../components/PlannerGrid.astro';
import Thumb from '../components/Thumb.astro';
import data from '../data/projects.json';

const { person, areas, featured, other } = data;
const highlights = featured.filter((p) => p.highlight);
const linkedin = person.links.find((l) => l.label === 'LinkedIn')!;
const github = person.links.find((l) => l.label === 'GitHub')!;
// The name is set on two lines, split before "Bin".
const [first, second] = person.name.split(/ (?=Bin )/);
---
<Base
  title={`${person.name}: student engineer, robotics and systems projects`}
  description="Projects in C++, Java and Python: a container terminal simulator, multi-robot path planning, ROS 2 autonomy, LiDAR perception, a banking ledger, and AI-security tools. Every number links to its source."
  section="home"
>
  <section class="hero wrap" aria-labelledby="who">
    <div class="intro">
      <h1 id="who" class="name">
        <span class="rise" style="--i:0">{first}</span>
        <span class="rise second" style="--i:1">{second}</span>
      </h1>
      <p class="lede rise" style="--i:3">{person.tagline}</p>
      <ul class="btn-row rise" style="--i:4">
        <li><a class="btn primary" href="/projects/">View projects</a></li>
        <li><a class="btn" href="/about/">About me</a></li>
      </ul>
      <ul class="social rise" style="--i:5">
        <li><a href={github.href}>GitHub</a></li>
        <li><a href={linkedin.href}>LinkedIn</a></li>
      </ul>
    </div>
    <div class="map">
      <PlannerGrid />
    </div>
  </section>

  <section class="wrap highlights" aria-labelledby="hl-title">
    <div class="section-head">
      <h2 id="hl-title">Robots, fleets and sensors</h2>
      <a class="btn small" href="/projects/">All {featured.length} projects</a>
    </div>
    <ul class="tiles">
      {highlights.map((p) => (
        <li class="tile">
          <Thumb p={p} />
          <div class="tile-text">
            <h3><a href={`/projects/${p.slug}/`}>{p.title}</a></h3>
            <p class="repo">{p.name}</p>
            <p class="summary">{p.summary}</p>
          </div>
          <a class="btn small" href={`/projects/${p.slug}/`}>Open project<span class="visually-hidden">: {p.title}</span></a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap areas" aria-labelledby="areas-title">
    <h2 id="areas-title">Everything, by area</h2>
    <ul class="area-list">
      {areas.map((a) => {
        const ps = featured.filter((p) => p.area === a.id);
        return (
          <li>
            <h3><a href={`/projects/#${a.id}`}>{a.title}</a></h3>
            <p>{a.blurb}</p>
            <p class="which">{ps.map((p) => p.title).join(', ')}</p>
          </li>
        );
      })}
      <li>
        <h3><a href="/projects/#other-work">Other work</a></h3>
        <p>Smaller C++ repos: trading-system components, performance experiments and a team assignment.</p>
        <p class="which">{other.map((o) => o.name).join(', ')}</p>
      </li>
    </ul>
  </section>
</Base>

<style>
  /* Hero: name and actions left, the planner map right; stacked on phones with the map under the text. */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: 3rem 4rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3.5rem; padding-block: 5rem 6rem; }
  }
  .intro, .map { min-width: 0; }
  .name {
    font-size: clamp(3rem, 1rem + 5.4vw, 6rem);
    line-height: 0.9;
    letter-spacing: 0;
    margin-bottom: 1.6rem;
  }
  .name span { display: block; }
  /* The second line of the name is set in outline: same word shape, quieter. */
  .name .second { color: transparent; -webkit-text-stroke: 2px var(--chalk); }
  @supports not (-webkit-text-stroke: 2px red) { .name .second { color: var(--chalk-2); } }
  .lede { margin-bottom: 1.75rem; }
  .social { display: flex; gap: 1.25rem; margin: 1.25rem 0 0; padding: 0; list-style: none; font-weight: 700; }
  .social a { display: inline-block; padding-block: 0.4rem; }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  h2 { font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem); }

  .tiles { display: grid; gap: 3rem 2.5rem; margin: 0; padding: 0; list-style: none; }
  .tile { display: grid; gap: 1.1rem; align-content: start; justify-items: start; min-width: 0; }
  .tile :global(.thumb) { width: 100%; }
  .tile-text { display: grid; gap: 0.3rem; }
  .tile h3 { font-size: clamp(1.9rem, 1.5rem + 1vw, 2.4rem); }
  .tile h3 a { text-decoration: none; }
  .tile h3 a:hover { text-decoration: underline; text-decoration-color: var(--amber); }
  .summary { margin: 0.4rem 0 0; max-width: 52ch; }
  /* Uneven pairs: wide-narrow, then narrow-wide. */
  @media (min-width: 800px) {
    .tiles { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .tile:nth-child(4n + 1), .tile:nth-child(4n + 4) { grid-column: span 7; }
    .tile:nth-child(4n + 2), .tile:nth-child(4n + 3) { grid-column: span 5; }
    /* The right-hand column sits lower, so the rows don't read as a table. */
    .tile:nth-child(even) { margin-top: 4rem; }
  }

  .areas { margin-top: 6rem; }
  .areas h2 { margin-bottom: 2rem; }
  .area-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--chalk);
  }
  .area-list li { padding: 1.4rem 0 1.5rem; border-bottom: 1px solid var(--rule); min-width: 0; }
  @media (min-width: 800px) {
    .area-list { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 2rem; }
    .area-list li { border-bottom: 0; }
  }
  .area-list h3 { font-size: 1.85rem; margin-bottom: 0.6rem; }
  .area-list h3 a { text-decoration-thickness: 2px; }
  .area-list p { margin: 0 0 0.6rem; font-size: var(--step--1); line-height: 1.55; }
  .which { color: var(--chalk-2); overflow-wrap: anywhere; }
</style>
