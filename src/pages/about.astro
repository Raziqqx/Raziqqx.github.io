---
// About: only facts that the repos and projects.json support. No invented school, awards or jobs.
import Base from '../layouts/Base.astro';
import data from '../data/projects.json';

const { person, areas, featured, other } = data;
const all = [...featured.map((p) => ({ name: p.title, href: `/projects/${p.slug}/`, stack: p.stack })),
             ...other.map((o) => ({ name: o.name, href: o.github, stack: o.stack }))];

// Languages, counted from each repo's stack tags (C++17 and C++20 both count as C++).
const languages = [
  { name: 'C++', test: /^C\+\+/ },
  { name: 'Python', test: /^Python$/ },
  { name: 'Java', test: /^Java\b/ },
  { name: 'TypeScript', test: /^TypeScript$/ },
].map((l) => ({ ...l, repos: all.filter((r) => r.stack.some((t) => l.test.test(t))) }));

// Optional, and empty for now: renders nothing until filled in projects.json.
const education = (person.education ?? []) as { place: string; what: string; when?: string }[];
---
<Base
  title={`About ${person.name}`}
  description={`Who ${person.name} is, the languages and areas he works in, and how he checks his work.`}
  section="about"
>
  <div class="wrap about">
    <header class="head">
      <h1 class="page-title rise" style="--i:0">About</h1>
      <p class="lede rise" style="--i:1">I'm {person.name}. {person.tagline.replace(/^Student engineer\. /, "I'm a student engineer, and ")}</p>
      <ul class="btn-row rise" style="--i:3">
        {person.links.map((l, i) => <li><a class={i === 0 ? 'btn primary' : 'btn'} href={l.href}>{l.label}</a></li>)}
      </ul>
    </header>

    <section aria-labelledby="areas">
      <h2 id="areas">What I work on</h2>
      <ul class="areas">
        {areas.map((a) => (
          <li>
            <h3>{a.title}</h3>
            <p>{a.blurb}</p>
            <ul class="plain">
              {featured.filter((p) => p.area === a.id).map((p) => <li><a href={`/projects/${p.slug}/`}>{p.title}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="langs">
      <h2 id="langs">Languages</h2>
      <p class="sub">How many of the {all.length} repos on this site use each one, counted from their stack lists.</p>
      <ul class="langs">
        {languages.map((l) => (
          <li>
            <span class="lang">{l.name}</span>
            <span class="cells" aria-hidden="true">
              {all.map((_, i) => <span class={i < l.repos.length ? 'on' : ''}></span>)}
            </span>
            <span class="n">{l.repos.length} of {all.length}</span>
            <span class="which">{l.repos.map((r) => r.name).join(', ')}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="how">
      <h2 id="how">How I work</h2>
      <ul class="how">
        <li>
          <h3>Tested</h3>
          <p>Each featured project has tests or correctness checks, not only a demo.</p>
        </li>
        <li>
          <h3>Numbers you can rerun</h3>
          <p>Each featured project has a way to reproduce its numbers, and this site names the file every number comes from.</p>
        </li>
        <li>
          <h3>Limits stated</h3>
          <p>When a project runs on synthetic data, a simulator or a mock model, it says so beside the numbers.</p>
        </li>
        <li>
          <h3>Design written down</h3>
          <p>Each featured repo has a docs/DESIGN.md with the alternatives considered and the known limitations.</p>
        </li>
      </ul>
    </section>

    {education.length > 0 && (
      <section aria-labelledby="edu">
        <h2 id="edu">Education</h2>
        <ul class="plain edu">
          {education.map((e) => <li><strong>{e.place}</strong>, {e.what}{e.when && <> ({e.when})</>}</li>)}
        </ul>
      </section>
    )}

    <section aria-labelledby="contact" class="contact">
      <h2 id="contact">Get in touch</h2>
      <p>Send me a message on LinkedIn, or read the code on GitHub.</p>
      <ul class="btn-row">
        {person.links.map((l, i) => <li><a class={i === 1 ? 'btn primary' : 'btn'} href={l.href}>{l.label}</a></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .head { padding-block: 3rem 1rem; display: grid; gap: 1.25rem; justify-items: start; }
  .head p { margin: 0; }
  section { margin-top: 4.5rem; }
  h2 {
    font-size: clamp(2.4rem, 1.6rem + 3vw, 3.6rem);
    padding-top: 1rem;
    border-top: 2px solid var(--chalk);
    margin-bottom: 1.75rem;
  }
  h3 { font-size: 1.85rem; margin-bottom: 0.5rem; }
  .sub { color: var(--chalk-2); max-width: var(--measure); margin-top: -0.75rem; }
  .plain { margin: 0; padding: 0; list-style: none; }
  .plain li { padding-block: 0.2rem; }

  .areas, .how { display: grid; gap: 2rem 2.5rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 800px) {
    .areas { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .how { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .areas > li, .how > li { min-width: 0; }
  .areas p { color: var(--chalk-2); font-size: var(--step--1); }
  .how > li { padding: 1.25rem 1.25rem 0.5rem; background: var(--field-deep); border-left: 6px solid var(--amber); }
  .how p { max-width: 52ch; }

  /* One row per language: a strip of cells, one per repo, lit for each repo that uses it. */
  .langs { margin: 0; padding: 0; list-style: none; display: grid; gap: 1.25rem; }
  .langs li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, auto) 1fr;
    gap: 0.4rem 1rem;
    align-items: center;
  }
  .lang { font-family: var(--display); font-weight: 800; font-size: 1.75rem; line-height: 1; }
  .cells { display: flex; gap: 3px; }
  .cells span { width: 18px; height: 18px; border: 1px solid var(--rule); }
  .cells .on { background: var(--amber); border-color: var(--amber); }
  .n { color: var(--chalk); font-weight: 700; }
  .which { grid-column: 2 / -1; color: var(--chalk-2); font-size: var(--step--1); }
  @media (max-width: 560px) {
    .langs li { grid-template-columns: 1fr auto; }
    .lang { grid-column: 1 / -1; }
    .cells span { width: 14px; height: 14px; }
    .which { grid-column: 1 / -1; }
  }
  .contact p { max-width: var(--measure); }
</style>
