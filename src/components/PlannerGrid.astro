---
// The hero map: a real A* search on a small occupancy grid, run at build time.
// The page animates the cells in the order the search expanded them, then draws the path and drives a
// robot along it. With `blocked`, the goal is walled off: the search floods every reachable cell and
// returns no path (the 404 page).
interface Props { blocked?: boolean; caption?: boolean }
const { blocked = false, caption = true } = Astro.props;

const W = 24, H = 15, C = 20; // columns, rows, cell size in SVG units
const start = { x: 1, y: 1 };
const goal = { x: 22, y: 13 };

// Obstacles as [x, y, w, h] in cells: yard blocks and a quay-side row.
const blocks: [number, number, number, number][] = [
  [4, 2, 3, 4], [10, 0, 2, 6], [15, 3, 5, 2], [6, 9, 6, 2], [14, 8, 2, 5], [19, 9, 3, 2], [2, 12, 3, 2],
];
// For the 404: a closed ring around the goal.
const ring: [number, number, number, number][] = [[20, 12, 4, 1], [20, 13, 1, 2]];
const walls = blocked ? [...blocks, ring[0], ring[1]] : blocks;

const blockedCell = new Set<string>();
for (const [x, y, w, h] of walls) for (let i = 0; i < w; i++) for (let j = 0; j < h; j++) blockedCell.add(`${x + i},${y + j}`);

// A*: 4-connected, Manhattan heuristic; ties broken toward the larger g (deeper nodes first).
type Node = { x: number; y: number; g: number; f: number };
const key = (x: number, y: number) => `${x},${y}`;
const hcost = (x: number, y: number) => Math.abs(x - goal.x) + Math.abs(y - goal.y);
const open: Node[] = [{ ...start, g: 0, f: hcost(start.x, start.y) }];
const best = new Map<string, number>([[key(start.x, start.y), 0]]);
const parent = new Map<string, string>();
const closed = new Set<string>();
const expanded: { x: number; y: number }[] = [];
let found = false;
while (open.length) {
  open.sort((a, b) => a.f - b.f || b.g - a.g);
  const n = open.shift()!;
  const k = key(n.x, n.y);
  if (closed.has(k)) continue;
  closed.add(k);
  expanded.push({ x: n.x, y: n.y });
  if (n.x === goal.x && n.y === goal.y) { found = true; break; }
  for (const [dx, dy] of [[1, 0], [0, 1], [-1, 0], [0, -1]]) {
    const x = n.x + dx, y = n.y + dy, nk = key(x, y);
    if (x < 0 || y < 0 || x >= W || y >= H || blockedCell.has(nk) || closed.has(nk)) continue;
    const g = n.g + 1;
    if (g < (best.get(nk) ?? Infinity)) {
      best.set(nk, g);
      parent.set(nk, k);
      open.push({ x, y, g, f: g + hcost(x, y) });
    }
  }
}

// Path cells from goal back to start, then only the corners for the polyline.
const cells: [number, number][] = [];
if (found) {
  let k: string | undefined = key(goal.x, goal.y);
  while (k) { const [x, y] = k.split(',').map(Number); cells.unshift([x, y]); k = parent.get(k); }
}
const corners = cells.filter((c, i) => {
  if (i === 0 || i === cells.length - 1) return true;
  const [a, b] = [cells[i - 1], cells[i + 1]];
  return !(a[0] === b[0] || a[1] === b[1]);
});
const px = (v: number) => v * C + C / 2;
const points = corners.map(([x, y]) => `${px(x)},${px(y)}`).join(' ');
const d = corners.map(([x, y], i) => `${i ? 'L' : 'M'}${px(x)} ${px(y)}`).join(' ');
const steps = Math.max(0, cells.length - 1);
const length = steps * C;

// Timing: the flood takes ~1.1 s whatever the cell count, then the path and the robot.
const flood = 1100;
const per = flood / Math.max(1, expanded.length);
const pathAt = 250 + flood;
---
<figure class="planner" style={`--path-len:${length};--path-at:${pathAt}ms;--path-d:path('${d}')`}>
  <svg viewBox={`0 0 ${W * C} ${H * C}`} role="img" aria-labelledby="planner-cap" preserveAspectRatio="xMidYMid meet">
    <defs>
      <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" fill="#0b2c4a" />
        <line x1="0" y1="0" x2="0" y2="6" stroke="rgba(238,243,247,0.28)" stroke-width="2" />
      </pattern>
      <pattern id="cells" width={C} height={C} patternUnits="userSpaceOnUse">
        <path d={`M ${C} 0 L 0 0 0 ${C}`} fill="none" stroke="rgba(238,243,247,0.12)" stroke-width="1" />
      </pattern>
    </defs>
    <rect width={W * C} height={H * C} fill="rgba(11,44,74,0.72)" />
    <g class="explored">
      {expanded.map((c, i) => (
        <rect x={c.x * C + 1} y={c.y * C + 1} width={C - 2} height={C - 2} style={`--t:${Math.round(250 + i * per)}ms`} />
      ))}
    </g>
    <rect width={W * C} height={H * C} fill="url(#cells)" />
    <g>
      {walls.map(([x, y, w, h]) => (
        <rect x={x * C} y={y * C} width={w * C} height={h * C} fill="url(#hatch)" stroke="rgba(238,243,247,0.45)" stroke-width="1.5" />
      ))}
    </g>
    {found && <polyline class="route" points={points} fill="none" stroke="#ffb627" stroke-width="5" stroke-linejoin="miter" stroke-linecap="square" />}
    <circle cx={px(start.x)} cy={px(start.y)} r="6" fill="none" stroke="#eef3f7" stroke-width="2.5" />
    <rect class="goal" x={px(goal.x) - 6} y={px(goal.y) - 6} width="12" height="12" fill="none" stroke="#ff6a3d" stroke-width="2.5" transform={`rotate(45 ${px(goal.x)} ${px(goal.y)})`} />
    {found && <rect class="robot" x="-6" y="-6" width="12" height="12" fill="#ff6a3d" stroke="#0b2c4a" stroke-width="2" />}
  </svg>
  {caption && (
    <figcaption id="planner-cap">
      {found
        ? `A* search on a ${W} × ${H} yard map, run when this site was built: ${expanded.length} cells expanded, a ${steps}-step path from start to goal.`
        : `A* search on a ${W} × ${H} yard map, run when this site was built: ${expanded.length} cells expanded and no path to the goal.`}
    </figcaption>
  )}
  {!caption && <figcaption id="planner-cap" class="visually-hidden">A grid map with a planned route between obstacles.</figcaption>}
</figure>

<style>
  .planner { margin: 0; position: relative; }
  svg { display: block; width: 100%; height: auto; border: 1px solid var(--rule); }
  .explored rect { fill: #5aa9e6; opacity: 0.3; }
  .robot { offset-path: var(--path-d); offset-distance: 100%; offset-rotate: 0deg; }
  figcaption {
    margin-top: 0.6rem;
    color: var(--chalk-2);
    font-size: var(--step--1);
    line-height: 1.5;
    max-width: 60ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .explored rect { animation: probe 500ms ease-out both; animation-delay: var(--t); }
    .route {
      stroke-dasharray: var(--path-len);
      animation: draw 900ms var(--ease-out) both;
      animation-delay: var(--path-at);
    }
    .robot { animation: drive 1500ms cubic-bezier(0.45, 0, 0.25, 1) both; animation-delay: calc(var(--path-at) + 700ms); }
    .goal { animation: blink 900ms steps(2) 3; animation-delay: var(--path-at); }
  }
  /* Each expanded cell flashes bright, then settles to the faint sky-blue explored tint (amber stays for the route). */
  @keyframes probe {
    0% { opacity: 0; }
    30% { opacity: 0.85; }
    100% { opacity: 0.3; }
  }
  @keyframes draw { from { stroke-dashoffset: var(--path-len); } to { stroke-dashoffset: 0; } }
  @keyframes drive { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  @keyframes blink { 50% { opacity: 0.2; } }
</style>
