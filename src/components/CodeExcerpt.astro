---
// A verbatim excerpt from a repo, with its real line numbers and a link to the file on GitHub.
interface Props {
  code: string;
  path: string;
  lines: string; // "48–60"
  lang: string;
  caption: string;
  github: string;
}
const { code, path, lines, lang, caption, github } = Astro.props;
const start = Number(lines.split(/[–-]/)[0]);
const end = Number(lines.split(/[–-]/)[1]);
const href = `${github}/blob/HEAD/${path}#L${start}-L${end}`;
const rows = code.split('\n').map((text, i) => ({ n: start + i, text }));
const label = `Code from ${path}, lines ${lines}`;
---
<figure class="excerpt">
  <div class="panel detect">
    <pre data-lang={lang} tabindex="0" role="region" aria-label={label}><code>{rows.map((r) => <span class="row"><span class="n" aria-hidden="true">{r.n}</span>{r.text}</span>)}</code></pre>
  </div>
  <figcaption>
    {caption} <a class="path" href={href}>{path}, lines {lines}</a>
  </figcaption>
</figure>

<style>
  .excerpt { margin: 0; }
  .panel { background: var(--field-deep); }
  /* The detection box sits outside the panel; the scroller is an inner element so it is not clipped. */
  pre {
    margin: 0;
    padding: 1rem 1rem 1rem 0;
    font-size: 0.74rem;
    line-height: 1.75;
    tab-size: 2;
    overflow-x: auto;
    color: var(--chalk);
  }
  .row { display: block; white-space: pre; }
  .n {
    display: inline-block;
    width: 3.4em;
    padding-right: 1em;
    margin-right: 0.25em;
    text-align: right;
    color: var(--chalk-2);
    user-select: none;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--chalk-2);
    line-height: 1.5;
    max-width: var(--measure);
  }
</style>
