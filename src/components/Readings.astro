---
// Measured results: the value with its unit, what was measured, and the file it came from.
interface Reading { value: string; label: string; source: string }
interface Props { items: Reading[]; caption: string; captionHidden?: boolean; reveal?: boolean }
// reveal: rows fade in one after another (after the text column and media of a project sheet).
const { items, caption, captionHidden = true, reveal = false } = Astro.props;
---
<table class="readings">
  <caption class={captionHidden ? 'visually-hidden' : ''}>{caption}</caption>
  <thead class="visually-hidden">
    <tr><th scope="col">Value</th><th scope="col">What was measured, and the source file</th></tr>
  </thead>
  <tbody>
    {items.map((r, i) => (
      <tr data-reveal={reveal ? 'row' : undefined} style={reveal ? `--d:${200 + i * 90}` : undefined}>
        <th scope="row" class="value">{r.value}</th>
        <td>
          {r.label}
          <span class="source">Source: <span class="path">{r.source}</span></span>
        </td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .readings {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    line-height: 1.5;
  }
  tr { border-top: 1px solid var(--rule); }
  tr:last-child { border-bottom: 1px solid var(--rule); }
  th, td { padding: 0.65rem 0; vertical-align: baseline; text-align: left; }
  .value {
    width: 38%;
    padding-right: 1rem;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: normal;
  }
  .source {
    display: block;
    margin-top: 0.2rem;
    color: var(--ink-2);
  }
  @media (max-width: 420px) {
    .value { width: 40%; font-size: var(--step-0); }
  }
</style>
