---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import data from '../data/projects.json';

interface Props {
  title: string;
  description: string;
  /** Detail pages show a small header with a way home; the home page has its own hero. */
  showHeader?: boolean;
}
const { title, description, showHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#e8ecea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1b22" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {showHeader && (
      <header class="site-header wrap">
        <a class="home" href="/">{data.person.name}</a>
        <ul class="links">
          {data.person.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>
        Every number on this site is copied from the linked repository's results folder or README, and the
        file it came from is named under it. Projects marked with a note ran on synthetic data, a simulator or a
        mock model.
      </p>
      <ul class="links">
        {data.person.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="https://github.com/Raziqqx/Raziqqx.github.io">Site source</a></li>
      </ul>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .home {
    color: var(--ink);
    font-stretch: 125%;
    font-weight: 800;
    text-decoration: none;
    font-size: var(--step-1);
  }
  .site-footer {
    margin-top: 5rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .site-footer p { max-width: 68ch; margin: 0 0 1rem; }
</style>
